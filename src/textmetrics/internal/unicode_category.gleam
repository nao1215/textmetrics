      || { code >= 0x116d0 && code <= 0x116e3 }
    0x117 -> {
      code >= 0x11730 && code <= 0x11739
    }
    0x118 -> {
      code >= 0x118e0 && code <= 0x118e9
    }
    0x119 -> {
