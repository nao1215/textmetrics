      || { code >= 0x10d40 && code <= 0x10d49 }
    0x110 ->
      { code >= 0x11066 && code <= 0x1106f }
      || code == 0x110bd
      || code == 0x110cd
      || { code >= 0x110f0 && code <= 0x110f9 }
    0x111 ->
      { code >= 0x11136 && code <= 0x1113f }
