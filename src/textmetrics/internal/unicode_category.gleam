  }
}

/// True for Word_Break=MidLetter, MidNumLet and Single_Quote code points,
/// which join two letters into one word (WB6, WB7).
pub fn joins_letters(code: Int) -> Bool {
  case code / 256 {
    0x0 -> code == 0x27 || code == 0x2e || code == 0x3a || code == 0xb7
    0x3 -> code == 0x387
    0x5 -> code == 0x55f || code == 0x5f4
    0x20 ->
      { code >= 0x2018 && code <= 0x2019 } || code == 0x2024 || code == 0x2027
    0xfe -> code == 0xfe13 || code == 0xfe52 || code == 0xfe55
    0xff -> code == 0xff07 || code == 0xff0e || code == 0xff1a
    _ -> False
  }
}

/// True for Word_Break=MidNum, MidNumLet and Single_Quote code points,
/// which join two digits into one number (WB11, WB12).
pub fn joins_numbers(code: Int) -> Bool {
  case code / 256 {
    0x0 -> code == 0x27 || code == 0x2c || code == 0x2e || code == 0x3b
    0x3 -> code == 0x37e
    0x5 -> code == 0x589
    0x6 -> { code >= 0x60c && code <= 0x60d } || code == 0x66c
    0x7 -> code == 0x7f8
    0x20 ->
      { code >= 0x2018 && code <= 0x2019 } || code == 0x2024 || code == 0x2044
    0xfe -> code == 0xfe50 || code == 0xfe52 || code == 0xfe54
    0xff -> code == 0xff07 || code == 0xff0c || code == 0xff0e || code == 0xff1b
    _ -> False
  }
}

/// True for Sentence_Break=Close code points, the quotation marks and
/// brackets that may follow a sentence terminator (SB9).
pub fn is_sentence_close(code: Int) -> Bool {
  case code / 256 {
    0x0 ->
      code == 0x22
      || { code >= 0x27 && code <= 0x29 }
      || code == 0x5b
      || code == 0x5d
      || code == 0x7b
      || code == 0x7d
      || code == 0xab
      || code == 0xbb
    0xf -> {
      code >= 0xf3a && code <= 0xf3d
    }
    0x16 -> {
      code >= 0x169b && code <= 0x169c
    }
    0x20 ->
      { code >= 0x2018 && code <= 0x201f }
      || { code >= 0x2039 && code <= 0x203a }
      || { code >= 0x2045 && code <= 0x2046 }
      || { code >= 0x207d && code <= 0x207e }
      || { code >= 0x208d && code <= 0x208e }
    0x23 ->
      { code >= 0x2308 && code <= 0x230b }
      || { code >= 0x2329 && code <= 0x232a }
    0x27 ->
      { code >= 0x275b && code <= 0x2760 }
      || { code >= 0x2768 && code <= 0x2775 }
      || { code >= 0x27c5 && code <= 0x27c6 }
      || { code >= 0x27e6 && code <= 0x27ef }
    0x29 ->
      { code >= 0x2983 && code <= 0x2998 }
      || { code >= 0x29d8 && code <= 0x29db }
      || { code >= 0x29fc && code <= 0x29fd }
    0x2e ->
      { code >= 0x2e00 && code <= 0x2e0d }
      || { code >= 0x2e1c && code <= 0x2e1d }
      || { code >= 0x2e20 && code <= 0x2e29 }
      || code == 0x2e42
      || { code >= 0x2e55 && code <= 0x2e5c }
    0x30 ->
      { code >= 0x3008 && code <= 0x3011 }
      || { code >= 0x3014 && code <= 0x301b }
      || { code >= 0x301d && code <= 0x301f }
    0xfd -> {
      code >= 0xfd3e && code <= 0xfd3f
    }
    0xfe ->
      { code >= 0xfe17 && code <= 0xfe18 }
      || { code >= 0xfe35 && code <= 0xfe44 }
      || { code >= 0xfe47 && code <= 0xfe48 }
      || { code >= 0xfe59 && code <= 0xfe5e }
    0xff ->
      { code >= 0xff08 && code <= 0xff09 }
      || code == 0xff3b
      || code == 0xff3d
      || code == 0xff5b
      || code == 0xff5d
      || { code >= 0xff5f && code <= 0xff60 }
      || { code >= 0xff62 && code <= 0xff63 }
    0x1f6 -> {
      code >= 0x1f676 && code <= 0x1f678
    }
    _ -> False
  }
}
